//
// =======================================================
// REPORT CARDS
// =======================================================
//
// Immutable academic snapshot generated only from published/locked Results.
// templateKey reserves multi-template support (STANDARD_A4 today).
//

model ReportCard {
  id Int @id @default(autoincrement())

  studentId      Int
  academicYearId Int
  termId         Int
  classId        Int

  /// Future-ready template registry key (e.g. STANDARD_A4, COMPACT_A4)
  templateKey String @default("STANDARD_A4")

  /// Full frozen snapshot: school, student, subjects, attendance, positions, grades
  snapshot Json

  totalScore   Decimal? @db.Decimal(8, 2)
  averageScore Decimal? @db.Decimal(6, 2)
  overallGrade String?
  classPosition Int?
  subjectCount  Int     @default(0)
  passedCount   Int     @default(0)
  failedCount   Int     @default(0)

  daysPresent           Int?
  daysAbsent            Int?
  daysLate              Int?
  daysExcused           Int?
  attendancePercentage  Decimal? @db.Decimal(5, 2)

  teacherRemarks     String? @db.Text
  headmasterRemarks  String? @db.Text

  promotionDecision PromotionDecision @default(PENDING)
  promoted          Boolean           @default(false)

  workflowStatus ReportCardWorkflowStatus @default(GENERATED)

  generatedAt   DateTime?
  generatedById Int?

  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById Int?

  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  publishedById Int?

  isLocked   Boolean   @default(false)
  lockedAt   DateTime?
  lockedById Int?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])
  schoolClass  SchoolClass  @relation(fields: [classId], references: [id])

  generatedBy  User? @relation("ReportCardGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  verifiedBy   User? @relation("ReportCardVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  publishedBy  User? @relation("ReportCardPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  lockedBy     User? @relation("ReportCardLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)

  promotions StudentPromotion[]

  @@unique([studentId, academicYearId, termId], map: "report_card_student_term_key")

  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([studentId])
  @@index([templateKey])
  @@index([workflowStatus])
  @@index([isVerified])
  @@index([isPublished])
  @@index([isLocked])
  @@index([promotionDecision])
  @@index([status])
  @@index([generatedById])
  @@index([verifiedById])
  @@index([publishedById])
  @@index([lockedById])

  @@map("report_cards")
}

//
// =======================================================
// STUDENT PROMOTIONS & GRADUATION
// =======================================================
//
// Year-end promotion / exit decisions driven by published Report Cards.
// Workflow: Draft (preview) → Approved → Executed (enroll / graduate).
//

model StudentPromotion {
  id Int @id @default(autoincrement())

  studentId          Int
  fromClassId        Int
  toClassId          Int?
  fromAcademicYearId Int
  toAcademicYearId   Int?
  termId             Int?
  reportCardId       Int?

  decision       PromotionDecision
  workflowStatus PromotionWorkflowStatus @default(DRAFT)

  averageScore  Decimal? @db.Decimal(6, 2)
  overallGrade  String?
  classPosition Int?
  subjectCount  Int?
  passedCount   Int?
  failedCount   Int?

  remarks             String? @db.Text
  recommendationNotes String? @db.Text

  recommendedAt   DateTime?
  recommendedById Int?

  approvedAt   DateTime?
  approvedById Int?

  executedAt          DateTime?
  executedById        Int?
  promotionDate       DateTime?
  resultingEnrollmentId Int?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClass        SchoolClass  @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClass          SchoolClass? @relation("PromotionToClass", fields: [toClassId], references: [id])
  fromAcademicYear AcademicYear @relation("PromotionFromYear", fields: [fromAcademicYearId], references: [id])
  toAcademicYear   AcademicYear? @relation("PromotionToYear", fields: [toAcademicYearId], references: [id])
  term             Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  reportCard       ReportCard?  @relation(fields: [reportCardId], references: [id], onDelete: SetNull)
  resultingEnrollment Enrollment? @relation("PromotionResultingEnrollment", fields: [resultingEnrollmentId], references: [id], onDelete: SetNull)

  recommendedBy User? @relation("PromotionRecommendedBy", fields: [recommendedById], references: [id], onDelete: SetNull)
  approvedBy    User? @relation("PromotionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  executedBy    User? @relation("PromotionExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)

  @@unique([studentId, fromAcademicYearId], map: "student_promotion_year_key")

  @@index([studentId])
  @@index([fromClassId])
  @@index([toClassId])
  @@index([fromAcademicYearId])
  @@index([toAcademicYearId])
  @@index([termId])
  @@index([reportCardId])
  @@index([decision])
  @@index([workflowStatus])
  @@index([status])
  @@index([recommendedById])
  @@index([approvedById])
  @@index([executedById])
  @@index([resultingEnrollmentId])

  @@map("student_promotions")
}

