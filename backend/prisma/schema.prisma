// =======================================================
// DIS-SMS ENTERPRISE ERP
// Prisma Schema
// Version: 2.0
// Database: MySQL
// ORM: Prisma
// =======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// =======================================================
// GLOBAL ENUMS
// =======================================================
//

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

//
// =======================================================
// SECURITY ENUMS
// =======================================================
//

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

//
// =======================================================
// ACADEMIC ENUMS
// =======================================================
//

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubjectCategory {
  CORE
  ELECTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  UNCLE
  AUNT
  BROTHER
  SISTER
  GRANDPARENT
  OTHER
}

//
// =======================================================
// FINANCE ENUMS
// =======================================================
//

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

//
// =======================================================
// COMMUNICATION ENUMS
// =======================================================
//

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

//
// =======================================================
// INVENTORY ENUMS
// =======================================================
//

enum StockMovementType {
  PURCHASE
  ISSUE
  RETURN
  ADJUSTMENT
  TRANSFER
}

//
// =======================================================
// HUMAN RESOURCE ENUMS
// =======================================================
//

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
  INTERN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

//
// =======================================================
// REPORT ENUMS
// =======================================================
//

enum ReportExecutionStatus {
  SUCCESS
  FAILED
  CANCELLED
}
//
// =======================================================
// SECURITY MODULE
// =======================================================
//

model Role {
  id Int @id @default(autoincrement())

  name        String @unique
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relationships
  users             User[]
  rolePermissions   RolePermission[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id Int @id @default(autoincrement())

  module      String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  rolePermissions RolePermission[]

  @@unique([module, name])

  @@index([module])

  @@map("permissions")
}

model RolePermission {
  id Int @id @default(autoincrement())

  roleId Int
  permissionId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])

  @@index([roleId])

  @@index([permissionId])

  @@map("role_permissions")
}
//
// =======================================================
// USERS
// =======================================================
//

model User {
  id Int @id @default(autoincrement())

  firstName String
  lastName String

  email String @unique
  password String

  roleId Int

  lastLogin DateTime?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // =====================================
  // SECURITY
  // =====================================

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  auditLogs AuditLog[]

  loginHistory LoginHistory[]

  systemLogs SystemLog[]

  systemBackups SystemBackup[]

  // =====================================
  // COMMUNICATION
  // =====================================

  notifications Notification[]
  publishedAnnouncements Announcement[]
  organizedEvents Event[]

  sentMessages Message[] @relation("MessageSender")

  receivedMessages Message[] @relation("MessageReceiver")

  receipts Receipt[]

  // =====================================
  // HUMAN RESOURCE
  // =====================================

  approvedLeaveRequests LeaveRequest[]

  // =====================================
  // HOSTEL
  // =====================================

  hostelInspections HostelInspection[]

  // =====================================
  // DASHBOARD
  // =====================================

  dashboards Dashboard[]

  reports Report[]

  reportExecutions ReportExecution[]

  @@index([roleId])

  @@index([status])

  @@map("users")
}
//
// =======================================================
// AUDIT LOGS
// =======================================================
//

model AuditLog {
  id Int @id @default(autoincrement())

  userId Int

  module String
  action String

  recordId Int?

  description String? @db.Text

  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@index([module])

  @@index([action])

  @@index([createdAt])

  @@map("audit_logs")
}

//
// =======================================================
// SYSTEM SETTINGS
// =======================================================
//

model SystemSetting {
  id Int @id @default(autoincrement())

  settingKey String @unique

  settingValue String @db.Text

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
//
// =======================================================
// ACADEMIC YEARS
// =======================================================
//

model AcademicYear {
  id Int @id @default(autoincrement())

  name String @unique

  startDate DateTime
  endDate   DateTime

  isCurrent Boolean @default(false)

  status AcademicYearStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Academic
  // ==============================
  terms         Term[]
  schoolClasses SchoolClass[]
  enrollments   Enrollment[]
  attendance    Attendance[]
  examinations  Examination[]
  feeStructures FeeStructure[]
  timetables    Timetable[]

  // ==============================
  // Hostel
  // ==============================
  bedAllocations BedAllocation[]

  @@index([status])
  @@index([isCurrent])

  @@map("academic_years")
}

//
// =======================================================
// TERMS
// =======================================================
//

model Term {
  id Int @id @default(autoincrement())

  academicYearId Int

  code String
  name String
  description String?

  startDate DateTime
  endDate   DateTime

  isCurrent Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // ==============================
  // Academic
  // ==============================
  attendance   Attendance[]
  examinations Examination[]
  results      Result[]
  timetables   Timetable[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, code])

  @@index([academicYearId])
  @@index([status])
  @@index([isCurrent])
  @@index([code])

  @@map("terms")
}

//
// =======================================================
// DEPARTMENTS
// =======================================================
//

model Department {
  id Int @id @default(autoincrement())

  code String @unique

  name String @unique

  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Academic
  // ==============================

  teachers Teacher[]

  subjects Subject[]

  schoolClasses SchoolClass[]

  // ==============================
  // Human Resources
  // ==============================

  employees Employee[]

  // ==============================
  // Inventory
  // ==============================

  stockIssues StockIssue[]

  @@index([status])

  @@map("departments")
}

//
// =======================================================
// SCHOOL CLASSES
// =======================================================
//

model SchoolClass {
  id Int @id @default(autoincrement())

  classCode String
  className String

  academicYearId Int
  departmentId   Int?
  classTeacherId Int?

  capacity    Int
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classTeacher Teacher?     @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)

  subjects      Subject[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]
  students      Student[]
  timetables    Timetable[]

  @@unique([academicYearId, classCode])

  @@index([academicYearId])
  @@index([departmentId])
  @@index([classTeacherId])
  @@index([status])
  @@index([classCode])

  @@map("school_classes")
}

//
// =======================================================
// TEACHERS
// =======================================================
//

model Teacher {
  id Int @id @default(autoincrement())

  staffNo String @unique

  firstName String
  lastName String

  gender Gender

  email String? @unique
  phone String?
  address String?
  qualification String?

  employmentDate DateTime?

  departmentId Int

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Relationships
  // ==============================

  department Department @relation(fields: [departmentId], references: [id])

  teacherSubjects TeacherSubject[]

  examinations Examination[]

  classTeacherOf SchoolClass[] @relation("ClassTeacher")

  timetables Timetable[] @relation("TeacherTimetables")
  timetableEntries TimetableEntry[] @relation("TeacherTimetableEntries")

  @@index([departmentId])
  @@index([status])

  @@map("teachers")
}

//
// =======================================================
// SUBJECTS
// =======================================================
//

model Subject {
  id Int @id @default(autoincrement())

  subjectCode String @unique
  subjectName String @unique
  shortName   String

  departmentId  Int?
  schoolClassId Int?

  category    SubjectCategory @default(CORE)
  creditHours Int             @default(1)
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Relationships
  // ==============================

  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schoolClass SchoolClass? @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)

  teacherSubjects TeacherSubject[]

  examinations Examination[]

  results Result[]

  timetables       Timetable[]      @relation("SubjectTimetables")
  timetableEntries TimetableEntry[] @relation("SubjectTimetableEntries")

  @@index([departmentId])
  @@index([schoolClassId])
  @@index([category])
  @@index([status])
  @@index([subjectCode])

  @@map("subjects")
}

//
// =======================================================
// TEACHER SUBJECT ASSIGNMENT
// =======================================================
//

model TeacherSubject {
  id Int @id @default(autoincrement())

  teacherId Int

  subjectId Int

  assignedDate DateTime @default(now())

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])

  @@index([teacherId])

  @@index([subjectId])

  @@index([status])

  @@map("teacher_subjects")
}
//
// =======================================================
// GUARDIANS
// =======================================================
//

model Guardian {
  id Int @id @default(autoincrement())

  guardianNumber String @unique

  firstName  String
  middleName String?
  lastName   String

  gender Gender

  dateOfBirth DateTime?

  nationalId String? @unique

  phone          String
  alternatePhone String?
  email          String?

  occupation String?
  employer   String?

  residentialAddress String?
  digitalAddress     String?

  photo String?
  notes String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Relationships
  // ==============================

  studentGuardians StudentGuardian[]

  @@index([phone])
  @@index([email])
  @@index([status])

  @@map("guardians")
}

//
// =======================================================
// STUDENT GUARDIAN ASSIGNMENT
// =======================================================
//

model StudentGuardian {
  id Int @id @default(autoincrement())

  studentId  Int
  guardianId Int

  relationship GuardianRelationship

  isPrimary               Boolean @default(false)
  emergencyContact        Boolean @default(false)
  financialResponsibility Boolean @default(false)
  canPickup               Boolean @default(false)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==============================
  // Relationships
  // ==============================

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])

  @@index([studentId])
  @@index([guardianId])
  @@index([relationship])
  @@index([isPrimary])

  @@map("student_guardians")
}

//
// =======================================================
// STUDENTS
// =======================================================
//

model Student {
  id Int @id @default(autoincrement())

  admissionNo String @unique

  firstName String
  lastName String

  otherName String?

  gender Gender

  dateOfBirth DateTime?

  email String?
  phone String?
  address String?

  admissionDate DateTime

  classId Int

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  studentGuardians StudentGuardian[]

  enrollments Enrollment[]
  attendance Attendance[]
  results Result[]

  invoices StudentInvoice[]
  payments Payment[]
  discounts StudentDiscount[]
  financialTransactions FinancialTransaction[]

  libraryMember LibraryMember?

  transportAssignments StudentTransport[]

  bedAllocations BedAllocation[]

  @@index([classId])
  @@index([status])

  @@map("students")
}

//
// =======================================================
// ENROLLMENTS
// =======================================================
//

model Enrollment {
  id Int @id @default(autoincrement())

  studentId Int

  classId Int

  academicYearId Int

  enrollmentDate DateTime @default(now())

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])

  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])

  @@map("enrollments")
}

//
// =======================================================
// STUDENT ATTENDANCE
// =======================================================
//

model Attendance {
  id Int @id @default(autoincrement())

  studentId Int

  academicYearId Int

  termId Int

  attendanceDate DateTime

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  @@unique([studentId, attendanceDate])

  @@index([studentId])
  @@index([attendanceDate])
  @@index([academicYearId])
  @@index([termId])

  @@map("attendance")
}

//
// =======================================================
// TIMETABLE
// =======================================================
//

model Timetable {
  id Int @id @default(autoincrement())

  academicYearId Int
  termId Int
  classId Int
  subjectId Int
  teacherId Int

  dayOfWeek String
  startTime String
  endTime String

  room String?
  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term Term @relation(fields: [termId], references: [id])
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  subject Subject @relation("SubjectTimetables", fields: [subjectId], references: [id])
  teacher Teacher @relation("TeacherTimetables", fields: [teacherId], references: [id])

  @@unique([academicYearId, termId, classId, dayOfWeek, startTime])
  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([status])

  @@map("timetables")
}

model TimetableEntry {
  id Int @id @default(autoincrement())

  subjectId Int
  teacherId Int

  dayOfWeek String
  startTime String
  endTime String

  room String?
  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation("SubjectTimetableEntries", fields: [subjectId], references: [id])
  teacher Teacher @relation("TeacherTimetableEntries", fields: [teacherId], references: [id])

  @@index([subjectId])
  @@index([teacherId])
  @@index([status])

  @@map("timetable_entries")
}

//
// =======================================================
// EXAMINATIONS
// =======================================================
//

model Examination {
  id Int @id @default(autoincrement())

  name String

  academicYearId Int
  termId Int

  subjectId Int
  teacherId Int

  examinationDate DateTime

  totalMarks Decimal @db.Decimal(6,2)
  passMarks  Decimal @db.Decimal(6,2)

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  subject Subject @relation(fields: [subjectId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  results Result[]

  @@index([academicYearId])
  @@index([termId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([status])

  @@map("examinations")
}

//
// =======================================================
// RESULTS
// =======================================================
//

model Result {
  id Int @id @default(autoincrement())

  examinationId Int
  studentId Int
  subjectId Int
  termId Int

  marks Decimal @db.Decimal(6,2)

  gradeId Int?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  grade Grade? @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  @@unique([examinationId, studentId])

  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@index([gradeId])

  @@map("results")
}

//
// =======================================================
// GRADES
// =======================================================
//

model Grade {
  id Int @id @default(autoincrement())

  grade String

  description String?

  minimumScore Decimal @db.Decimal(6,2)

  maximumScore Decimal @db.Decimal(6,2)

  gradePoint Decimal? @db.Decimal(4,2)

  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results Result[]

  @@unique([grade])

  @@index([status])

  @@map("grades")
}

//
// =======================================================
// GRADE SCALES
// =======================================================
//

model GradeScale {
  id Int @id @default(autoincrement())

  name String @unique

  description String?

  isDefault Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isDefault])

  @@map("grade_scales")
}
//
// =======================================================
// FINANCE - FEE TYPES
// =======================================================
//

model FeeType {
  id Int @id @default(autoincrement())

  code String @unique
  name String

  description String?

  isOptional Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  feeStructures FeeStructure[]

  @@index([status])

  @@map("fee_types")
}

//
// =======================================================
// FINANCE - FEE STRUCTURES
// =======================================================
//

model FeeStructure {
  id Int @id @default(autoincrement())

  feeTypeId Int

  classId Int

  academicYearId Int

  amount Decimal @db.Decimal(12,2)

  dueDate DateTime?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  invoices StudentInvoice[]

  @@unique([feeTypeId, classId, academicYearId])

  @@index([feeTypeId])
  @@index([classId])
  @@index([academicYearId])
  @@index([status])

  @@map("fee_structures")
}

//
// =======================================================
// FINANCE - STUDENT INVOICES
// =======================================================
//

model StudentInvoice {
  id Int @id @default(autoincrement())

  invoiceNumber String @unique

  studentId Int

  feeStructureId Int

  amount Decimal @db.Decimal(12,2)

  paidAmount Decimal @default(0) @db.Decimal(12,2)

  balance Decimal @db.Decimal(12,2)

  dueDate DateTime?

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  payments Payment[]

  paymentAllocations PaymentAllocation[]

  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])

  @@map("student_invoices")
}

//
// =======================================================
// FINANCE - PAYMENTS
// =======================================================
//

model Payment {
  id Int @id @default(autoincrement())

  receiptNumber String @unique

  studentId Int

  invoiceId Int

  amount Decimal @db.Decimal(12,2)

  paymentDate DateTime @default(now())

  paymentMethod PaymentMethod

  status PaymentStatus @default(COMPLETED)

  transactionReference String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  invoice StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  paymentAllocations PaymentAllocation[]
  receipt Receipt?
  financialTransactions FinancialTransaction[]

  @@index([studentId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([status])

  @@map("payments")
}
//
// =======================================================
// PAYMENT ALLOCATIONS
// =======================================================
//

model PaymentAllocation {
  id Int @id @default(autoincrement())

  paymentId Int
  invoiceId Int

  allocatedAmount Decimal @db.Decimal(12,2)

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoice StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])

  @@index([paymentId])
  @@index([invoiceId])

  @@map("payment_allocations")
}

//
// =======================================================
// RECEIPTS
// =======================================================
//

model Receipt {
  id Int @id @default(autoincrement())

  receiptNumber String @unique

  paymentId Int @unique

  issuedDate DateTime @default(now())

  issuedById Int

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  issuedBy User @relation(fields: [issuedById], references: [id])

  @@index([issuedDate])
  @@index([issuedById])

  @@map("receipts")
}

//
// =======================================================
// SCHOLARSHIPS
// =======================================================
//

model Scholarship {
  id Int @id @default(autoincrement())

  name String @unique

  sponsor String?

  percentage Decimal? @db.Decimal(5,2)

