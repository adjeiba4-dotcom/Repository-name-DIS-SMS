// =======================================================
// DIS-SMS ENTERPRISE ERP
// Prisma Schema
// Version: 2.0
// Database: MySQL
// ORM: Prisma
// =======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// =======================================================
// GLOBAL ENUMS
// =======================================================
//

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

//
// =======================================================
// SECURITY ENUMS
// =======================================================
//

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum FileCategory {
  LOGO
  PHOTO
  DOCUMENT
  OTHER
}

//
// =======================================================
// ACADEMIC ENUMS
// =======================================================
//

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  CLASS_WORK
  HOMEWORK
  QUIZ
  ASSIGNMENT
  PRACTICAL
  PROJECT
  ORAL_TEST
  MID_TERM
  CONTINUOUS_ASSESSMENT
}

enum ExaminationType {
  MID_TERM
  END_OF_TERM
  MOCK
  FINAL
  ENTRANCE
}

/// Results Engine release pipeline: Draft → Generated → Verified → Published → Locked
enum ResultWorkflowStatus {
  DRAFT
  GENERATED
  VERIFIED
  PUBLISHED
  LOCKED
}

/// Report Card release pipeline (mirrors Results): Generated → Verified → Published → Locked
enum ReportCardWorkflowStatus {
  DRAFT
  GENERATED
  VERIFIED
  PUBLISHED
  LOCKED
}

/// End-of-year / exit decision used by Report Cards and Student Promotions
enum PromotionDecision {
  PENDING
  PROMOTED
  PROMOTED_ON_PROBATION
  REPEAT
  GRADUATED
  WITHDRAWN
  TRANSFERRED
}

/// Promotion pipeline: Draft (preview) → Approved → Executed
enum PromotionWorkflowStatus {
  DRAFT
  APPROVED
  EXECUTED
  CANCELLED
}

enum SubjectCategory {
  CORE
  ELECTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  UNCLE
  AUNT
  BROTHER
  SISTER
  GRANDPARENT
  OTHER
}

//
// =======================================================
// FINANCE ENUMS
// =======================================================
//

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

//
// =======================================================
// COMMUNICATION ENUMS
// =======================================================
//

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

//
// =======================================================
// INVENTORY ENUMS
// =======================================================
//

enum StockMovementType {
  PURCHASE
  ISSUE
  RETURN
  ADJUSTMENT
  TRANSFER
}

//
// =======================================================
// HUMAN RESOURCE ENUMS
// =======================================================
//

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
  INTERN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

//
// =======================================================
// REPORT ENUMS
// =======================================================
//

enum ReportExecutionStatus {
  SUCCESS
  FAILED
  CANCELLED
}
//
// =======================================================
// SECURITY MODULE
// =======================================================
//

model Role {
  id Int @id @default(autoincrement())

  name        String @unique
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relationships
  users             User[]
  rolePermissions   RolePermission[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id Int @id @default(autoincrement())

  module      String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  rolePermissions RolePermission[]

  @@unique([module, name])

  @@index([module])

  @@map("permissions")
}

model RolePermission {
  id Int @id @default(autoincrement())

  roleId Int
  permissionId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])

  @@index([roleId])

  @@index([permissionId])

  @@map("role_permissions")
}
//
// =======================================================
// USERS
// =======================================================
//

model User {
  id Int @id @default(autoincrement())

  firstName String
  lastName String

  email String @unique
  password String

  roleId Int

  lastLogin DateTime?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // =====================================
  // SECURITY
  // =====================================

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  auditLogs AuditLog[]

  loginHistory LoginHistory[]

  systemLogs SystemLog[]

  systemBackups SystemBackup[]

  fileAssets FileAsset[]

  lockedExaminations Examination[] @relation("ExaminationLockedBy")
  publishedResults   Result[]      @relation("ResultPublishedBy")
  lockedResults      Result[]      @relation("ResultLockedBy")
  verifiedResults    Result[]      @relation("ResultVerifiedBy")

  generatedReportCards  ReportCard[] @relation("ReportCardGeneratedBy")
  verifiedReportCards   ReportCard[] @relation("ReportCardVerifiedBy")
  publishedReportCards  ReportCard[] @relation("ReportCardPublishedBy")
  lockedReportCards     ReportCard[] @relation("ReportCardLockedBy")

  recommendedPromotions StudentPromotion[] @relation("PromotionRecommendedBy")
  approvedPromotions    StudentPromotion[] @relation("PromotionApprovedBy")
  executedPromotions    StudentPromotion[] @relation("PromotionExecutedBy")

  // =====================================
  // COMMUNICATION
  // =====================================

  notifications Notification[]
  publishedAnnouncements Announcement[]
  organizedEvents Event[]

  sentMessages Message[] @relation("MessageSender")

  receivedMessages Message[] @relation("MessageReceiver")

  receipts Receipt[]

  // =====================================
  // HUMAN RESOURCE
  // =====================================

  approvedLeaveRequests LeaveRequest[]

  // =====================================
  // HOSTEL
  // =====================================

  hostelInspections HostelInspection[]

  // =====================================
  // DASHBOARD
  // =====================================

  dashboards Dashboard[]

  reports Report[]

  reportExecutions ReportExecution[]

  @@index([roleId])

  @@index([status])

  @@map("users")
}
//
// =======================================================
// AUDIT LOGS
// =======================================================
//

model AuditLog {
  id Int @id @default(autoincrement())

  userId Int

  module String
  action String

  entityType String?
  recordId   Int?

  description String? @db.Text

  oldValues Json?
  newValues Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])

  @@map("audit_logs")
}

//
// =======================================================
// SYSTEM SETTINGS
// =======================================================
//

model SystemSetting {
  id Int @id @default(autoincrement())

  settingKey String @unique

  settingValue String @db.Text

  description String?

  category String? @db.VarChar(50)

  dataType String @default("STRING") @db.VarChar(20)

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])

  @@map("system_settings")
}

//
// =======================================================
// SCHOOL PROFILE (singleton school identity)
// =======================================================
//

model SchoolProfile {
  id Int @id @default(autoincrement())

  schoolName String
  schoolCode String? @unique

  motto String?

  address    String? @db.Text
  city       String?
  region     String?
  country    String?
  postalCode String?

  phone   String?
  email   String?
  website String?

  logoUrl  String?
  stampUrl String?

  establishedYear   Int?
  accreditationInfo String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("school_profiles")
}

//
// =======================================================
// FILE ASSETS (shared upload registry)
// =======================================================
//

model FileAsset {
  id Int @id @default(autoincrement())

  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int

  category FileCategory @default(OTHER)

  path String
  url  String

  uploadedById Int?

  entityType String?
  entityId   Int?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([uploadedById])
  @@index([entityType, entityId])
  @@index([deletedAt])

  @@map("file_assets")
}
//
// =======================================================
// ACADEMIC YEARS
// =======================================================
//

model AcademicYear {
  id Int @id @default(autoincrement())

  name String @unique

  startDate DateTime
  endDate   DateTime

  isCurrent Boolean @default(false)

  status AcademicYearStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Academic
  // ==============================
  terms            Term[]
  schoolClasses    SchoolClass[]
  enrollments      Enrollment[]
  attendance       Attendance[]
  assessments      Assessment[]
  examinations     Examination[]
  results          Result[]
  reportCards      ReportCard[]
  feeStructures    FeeStructure[]
  timetables       Timetable[]
  teacherSubjects  TeacherSubject[]
  classSubjects    ClassSubject[]
  promotionsFrom   StudentPromotion[] @relation("PromotionFromYear")
  promotionsTo     StudentPromotion[] @relation("PromotionToYear")

  // ==============================
  // Hostel
  // ==============================
  bedAllocations BedAllocation[]

  @@index([status])
  @@index([isCurrent])

  @@map("academic_years")
}

//
// =======================================================
// TERMS
// =======================================================
//

model Term {
  id Int @id @default(autoincrement())

  academicYearId Int

  code String
  name String
  description String?

  startDate DateTime
  endDate   DateTime

  isCurrent Boolean @default(false)

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // ==============================
  // Academic
  // ==============================
  attendance      Attendance[]
  assessments     Assessment[]
  examinations    Examination[]
  results         Result[]
  reportCards     ReportCard[]
  timetables      Timetable[]
  teacherSubjects TeacherSubject[]
  classSubjects   ClassSubject[]
  enrollments     Enrollment[]
  promotions      StudentPromotion[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, code])

  @@index([academicYearId])
  @@index([status])
  @@index([isCurrent])
  @@index([code])

  @@map("terms")
}

//
// =======================================================
// DEPARTMENTS
// =======================================================
//

model Department {
  id Int @id @default(autoincrement())

  code String @unique

  name String @unique

  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Academic
  // ==============================

  teachers Teacher[]

  subjects Subject[]

  schoolClasses SchoolClass[]

  // ==============================
  // Human Resources
  // ==============================

  employees Employee[]

  // ==============================
  // Inventory
  // ==============================

  stockIssues StockIssue[]

  @@index([status])

  @@map("departments")
}

//
// =======================================================
// SCHOOL CLASSES
// =======================================================
//

model SchoolClass {
  id Int @id @default(autoincrement())

  classCode String
  className String

  academicYearId Int
  departmentId   Int?
  classTeacherId Int?

  capacity    Int
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classTeacher Teacher?     @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)

  subjects      Subject[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]
  students      Student[]
  timetables    Timetable[]
  classSubjects ClassSubject[]
  assessments   Assessment[]
  examinations  Examination[]
  results       Result[]
  reportCards   ReportCard[]
  promotionsFrom StudentPromotion[] @relation("PromotionFromClass")
  promotionsTo   StudentPromotion[] @relation("PromotionToClass")

  @@unique([academicYearId, classCode])

  @@index([academicYearId])
  @@index([departmentId])
  @@index([classTeacherId])
  @@index([status])
  @@index([classCode])

  @@map("school_classes")
}

//
// =======================================================
// TEACHERS
// =======================================================
//

model Teacher {
  id Int @id @default(autoincrement())

  staffNo String @unique

  firstName String
  lastName String

  gender Gender

  email String? @unique
  phone String?
  address String?
  qualification String?

  employmentDate DateTime?

  departmentId Int

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Relationships
  // ==============================

  department Department @relation(fields: [departmentId], references: [id])

  teacherSubjects TeacherSubject[]

  assessments  Assessment[]
  examinations Examination[]

  classTeacherOf SchoolClass[] @relation("ClassTeacher")

  timetables Timetable[] @relation("TeacherTimetables")
  timetableEntries TimetableEntry[] @relation("TeacherTimetableEntries")

  @@index([departmentId])
  @@index([status])

  @@map("teachers")
}

//
// =======================================================
// SUBJECTS
// =======================================================
//

model Subject {
  id Int @id @default(autoincrement())

  subjectCode String @unique
  subjectName String @unique
  shortName   String

  departmentId  Int?
  schoolClassId Int?

  category    SubjectCategory @default(CORE)
  creditHours Int             @default(1)
  description String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Relationships
  // ==============================

  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schoolClass SchoolClass? @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)

  teacherSubjects TeacherSubject[]
  classSubjects   ClassSubject[]

  assessments  Assessment[]
  examinations Examination[]

  results Result[]

  timetables       Timetable[]      @relation("SubjectTimetables")
  timetableEntries TimetableEntry[] @relation("SubjectTimetableEntries")

  @@index([departmentId])
  @@index([schoolClassId])
  @@index([category])
  @@index([status])
  @@index([subjectCode])

  @@map("subjects")
}

//
// =======================================================
// TEACHER SUBJECT ASSIGNMENT
// =======================================================
//

model TeacherSubject {
  id Int @id @default(autoincrement())

  teacherId      Int
  subjectId      Int
  academicYearId Int
  termId         Int?

  isPrimary     Boolean @default(false)
  weeklyPeriods Int     @default(1)
  remarks       String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)

  classSubjects ClassSubject[]

  @@unique([teacherId, subjectId, academicYearId, termId])

  @@index([teacherId])
  @@index([subjectId])
  @@index([academicYearId])
  @@index([termId])
  @@index([status])

  @@map("teacher_subjects")
}

//
// =======================================================
// CLASS SUBJECT ALLOCATION
// =======================================================
//

model ClassSubject {
  id Int @id @default(autoincrement())

  schoolClassId    Int
  teacherSubjectId Int
  subjectId        Int
  academicYearId   Int
  termId           Int?

  weeklyPeriods Int     @default(1)
  isCompulsory  Boolean @default(true)
  displayOrder  Int     @default(0)
  remarks       String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schoolClass    SchoolClass    @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  teacherSubject TeacherSubject @relation(fields: [teacherSubjectId], references: [id], onDelete: Restrict)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  term           Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([schoolClassId, subjectId, academicYearId, termId])

  @@index([schoolClassId])
  @@index([teacherSubjectId])
  @@index([subjectId])
  @@index([academicYearId])
  @@index([termId])
  @@index([status])
  @@index([displayOrder])

  @@map("class_subjects")
}
//
// =======================================================
// GUARDIANS
// =======================================================
//

model Guardian {
  id Int @id @default(autoincrement())

  guardianNumber String @unique

  firstName  String
  middleName String?
  lastName   String

  gender Gender

  dateOfBirth DateTime?

  nationalId String? @unique

  phone          String
  alternatePhone String?
  email          String?

  occupation String?
  employer   String?

  residentialAddress String?
  digitalAddress     String?

  photo String?
  notes String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ==============================
  // Relationships
  // ==============================

  studentGuardians StudentGuardian[]

  @@index([phone])
  @@index([email])
  @@index([status])

  @@map("guardians")
}

//
// =======================================================
// STUDENT GUARDIAN ASSIGNMENT
// =======================================================
//

model StudentGuardian {
  id Int @id @default(autoincrement())

  studentId  Int
  guardianId Int

  relationship GuardianRelationship

  isPrimary               Boolean @default(false)
  emergencyContact        Boolean @default(false)
  financialResponsibility Boolean @default(false)
  canPickup               Boolean @default(false)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==============================
  // Relationships
  // ==============================

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])

  @@index([studentId])
  @@index([guardianId])
  @@index([relationship])
  @@index([isPrimary])

  @@map("student_guardians")
}

//
// =======================================================
// STUDENTS
// =======================================================
//

model Student {
  id Int @id @default(autoincrement())

  admissionNo String @unique

  firstName String
  lastName String

  otherName String?

  gender Gender

  dateOfBirth DateTime?

  email String?
  phone String?
  address String?

  admissionDate DateTime

  classId Int

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  studentGuardians StudentGuardian[]

  enrollments Enrollment[]
  attendance Attendance[]
  assessmentScores AssessmentScore[]
  examinationScores ExaminationScore[]
  results Result[]
  reportCards ReportCard[]
  promotions StudentPromotion[]

  invoices StudentInvoice[]
  payments Payment[]
  discounts StudentDiscount[]
  financialTransactions FinancialTransaction[]

  libraryMember LibraryMember?

  transportAssignments StudentTransport[]

  bedAllocations BedAllocation[]

  @@index([classId])
  @@index([status])

  @@map("students")
}

//
// =======================================================
// ENROLLMENTS
// =======================================================
//

model Enrollment {
  id Int @id @default(autoincrement())

  enrollmentNumber String @unique

  studentId      Int
  schoolClassId  Int
  academicYearId Int
  termId         Int?

  enrollmentDate DateTime @default(now())

  status  Status  @default(ACTIVE)
  remarks String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass  @relation(fields: [schoolClassId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  promotions   StudentPromotion[] @relation("PromotionResultingEnrollment")

  @@unique([studentId, academicYearId])

  @@index([studentId])
  @@index([schoolClassId])
  @@index([academicYearId])
  @@index([termId])
  @@index([status])

  @@map("enrollments")
}

//
// =======================================================
// STUDENT ATTENDANCE
// =======================================================
//

model Attendance {
  id Int @id @default(autoincrement())

  studentId Int

  academicYearId Int

  termId Int

  attendanceDate DateTime

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  @@unique([studentId, attendanceDate])

  @@index([studentId])
  @@index([attendanceDate])
  @@index([academicYearId])
  @@index([termId])

  @@map("attendance")
}

//
// =======================================================
// TIMETABLE
// =======================================================
//

model Timetable {
  id Int @id @default(autoincrement())

  academicYearId Int
  termId Int
  classId Int
  subjectId Int
  teacherId Int

  dayOfWeek String
  startTime String
  endTime String

  room String?
  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term Term @relation(fields: [termId], references: [id])
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  subject Subject @relation("SubjectTimetables", fields: [subjectId], references: [id])
  teacher Teacher @relation("TeacherTimetables", fields: [teacherId], references: [id])

  @@unique([academicYearId, termId, classId, dayOfWeek, startTime])
  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([status])

  @@map("timetables")
}

model TimetableEntry {
  id Int @id @default(autoincrement())

  subjectId Int
  teacherId Int

  dayOfWeek String
  startTime String
  endTime String

  room String?
  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation("SubjectTimetableEntries", fields: [subjectId], references: [id])
  teacher Teacher @relation("TeacherTimetableEntries", fields: [teacherId], references: [id])

  @@index([subjectId])
  @@index([teacherId])
  @@index([status])

  @@map("timetable_entries")
}

//
// =======================================================
// ASSESSMENTS
// =======================================================
//

model Assessment {
  id Int @id @default(autoincrement())

  title String?

  academicYearId Int
  termId         Int
  classId        Int
  subjectId      Int
  teacherId      Int

  assessmentType AssessmentType
  maxMarks       Decimal        @db.Decimal(6, 2)
  assessmentDate DateTime

  remarks String?

  status Status @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

